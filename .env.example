# LMT v1 — Extension Environment Variables
# Copy this file to `.env` and fill in values before building.
#   cp .env.example .env    (or Copy-Item .env.example .env on Windows)
#
# `.env` is loaded by WXT/Vite at build time (import.meta.env.WXT_*).
# NEVER commit `.env` — keep secrets out of git.

# ── Update-check + "share site rule to GitHub" links ────────────────────
# Full repo URL without trailing slash. Leave empty to disable the
# "Update Available" banner and the share-to-GitHub button.
#   e.g. https://github.com/mrdhnto/libre-manga-translator
WXT_GITHUB_REPO=

# ── Model repos (overrides) ─────────────────────────────────────────────
# Defaults are used when these are empty. You normally do NOT need to change
# them unless you host your own weights.
WXT_RTDETR_MODEL_REPO=ogkalu/comic-text-and-bubble-detector
WXT_COMIC_TEXT_DETECTOR_URL=https://github.com/zyddnys/manga-image-translator/releases/download/beta-0.3/comictextdetector.pt.onnx
WXT_PADDLE_OCR_MODEL_REPO=monkt/paddleocr-onnx
WXT_MANGA_OCR_MODEL_REPO=mayocream/manga-ocr-onnx
WXT_PPOCRV6_MANGA_REPO=fumetodev/PP-OCRv6_small_rec_manga_ONNX
WXT_LAMA_INPAINT_MODEL_REPO=ogkalu/lama-manga-onnx-dynamic
WXT_GATE_MODEL_REPO=ogkalu/image-script-identification

# ── Privacy Policy URL ──────────────────────────────────────────────────
# URL for fetching the privacy policy markdown in onboarding setup.
# Local mock server: http://localhost:3001/privacy
# Production: https://raw.githubusercontent.com/mrdhnto/libre-manga-translator/refs/heads/main/privacy.md
WXT_PRIVACY_URL=
